# Copy to apps/mobile/.env (gitignored). Expo inlines EXPO_PUBLIC_* values at bundle time.

# Local Supabase stack (bun run supabase:start). Paste the anon key that `supabase status` prints.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# apps/api (bun run dev:api). A physical device cannot reach the Mac through localhost:
# use the Mac's LAN IP instead, e.g. http://192.168.0.10:3000, and the same host for EXPO_PUBLIC_SUPABASE_URL.
# An Android emulator (bun run android) reaches the Mac through 10.0.2.2 instead of localhost / 127.0.0.1:
# use http://10.0.2.2:3000 here and http://10.0.2.2:54321 for EXPO_PUBLIC_SUPABASE_URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
